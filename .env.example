# Base de données et file de tâches (valeurs locales ; docker-compose les remplace)
DATABASE_URL="postgresql://nexbrain:nexbrain@localhost:5432/nexbrain?schema=public"
REDIS_URL="redis://localhost:6379"

# Gemma 4 via l'API Gemini (clé : https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMMA_MODEL="gemma-4-26b-a4b-it"

# true → agents simulés, aucun appel IA (développement / démo hors ligne)
AI_MOCK="true"

# Quota mensuel de tokens par utilisateur, et plafond pour une analyse complète
AI_MONTHLY_TOKEN_QUOTA=2000000
AI_RUN_TOKEN_LIMIT=400000

# Cache des réponses IA au sein d'une analyse (reprises après échec), en secondes. 0 = désactivé
AI_CACHE_TTL_SECONDS=604800

# URL alternative de l'API Gemini (ex. faux serveur local : http://localhost:8787)
# GEMINI_BASE_URL=""

# Recherche web de l'agent Analyste (Tavily). Vide → « analyse non vérifiée »
SEARCH_API_KEY=""

# Durée de validité des sessions (jours)
SESSION_DAYS=30
